<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SMTP delivery for ApricotFramework.Mailer, built on MailKit: host, port, TLS mode and credentials read from the sending account, plus a pickup-directory transport that writes each message as an .eml file instead of delivering it.</Description>
    <PackageTags>email;mail;smtp;mailkit;mime;pickupdirectory</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.Mailer/ApricotFramework.Mailer.csproj" />
  </ItemGroup>

</Project>
