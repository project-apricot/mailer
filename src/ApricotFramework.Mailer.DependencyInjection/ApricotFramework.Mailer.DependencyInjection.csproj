<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Dependency-injection integration for ApricotFramework.Mailer: sending accounts bound from configuration, startup validation of every account against the registered transports, logging, an in-memory account cache, and the registration seam for accounts held in a database or a secrets store. Depends only on Microsoft.Extensions.*, so a worker or console host can use it.</Description>
    <PackageTags>email;mail;mailer;dependencyinjection;configuration;options</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.Mailer/ApricotFramework.Mailer.csproj" />
  </ItemGroup>

</Project>
